/* Quiet, layered workspace: hierarchy comes from surfaces rather than boxes. */

Screen {
    background: $surface;
}

Header, Footer {
    background: $primary-background;
}

Header {
    color: $text-muted;
}

Footer {
    color: $text-muted;
}

.eyebrow, .pane-title, .section-heading {
    color: $text-muted;
    text-style: bold;
}

#browse-header {
    height: auto;
    padding: 0 1;
    background: $panel;
    border-left: solid transparent;
}

#browse-header:focus-within {
    border-left: solid $accent;
    background-tint: $accent 3%;
}

#search-row {
    height: 3;
    layout: horizontal;
    align-vertical: middle;
}

#search-row > .eyebrow {
    width: 7;
    content-align: left middle;
}

#search-input {
    width: 1fr;
    border: none;
    background: $boost;
    padding: 0 1;
}

#search-input:focus {
    background: $boost 20%;
    border-bottom: solid $accent;
}

#lang-indicator {
    width: 5;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

FilterChips {
    height: 2;
    padding: 0 0 1 7;
    background: $panel;
}

FilterChips > Static {
    color: $text-muted;
}

FilterChips > .active {
    color: $accent;
    text-style: bold;
}

#workspace {
    height: 1fr;
    layout: horizontal;
    background: $surface;
}

.pane {
    height: 1fr;
    border-left: solid transparent;
}

.pane:focus-within {
    border-left: solid $accent;
    background-tint: $accent 3%;
}

.pane:focus-within > .pane-title,
#preview-pane:focus-within .eyebrow {
    color: $accent;
}

#results-pane {
    width: 52%;
    background: $panel;
}

#preview-pane {
    width: 48%;
    background: $boost;
}

.pane-title {
    height: 2;
    padding: 0 1;
    content-align: left middle;
}

#results {
    height: 1fr;
    background: $panel;
}

#results:focus {
    background-tint: $accent 3%;
}

DataTable > .datatable--header {
    background: $panel;
    color: $text-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent 22%;
    color: $text;
}

EventPreview {
    height: 1fr;
    padding: 1 2;
    background: $boost;
}

.preview-title {
    margin: 0 0 1 0;
    color: $text;
    text-style: bold;
}

.preview-empty, .preview-state {
    color: $text-muted;
    margin-top: 1;
}

.preview-error {
    color: $error;
    margin-top: 1;
}

.metadata-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: 14 1fr;
    grid-rows: auto;
    height: auto;
    margin-bottom: 1;
}

.metadata-label {
    width: 14;
    height: auto;
    color: $text-muted;
}

.metadata-value {
    width: 1fr;
    height: auto;
    color: $text;
}

.action-strip {
    margin: 1 0;
    padding: 0 1;
    height: auto;
    background: $surface;
    color: $text-muted;
}

.section-heading {
    margin: 1 0 0 0;
}

.prose {
    color: $text;
    margin-bottom: 1;
}

StatusBar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

StatusBar > #status-count { width: auto; }
StatusBar > #status-message { width: 1fr; content-align: left middle; }
StatusBar > #status-spinner {
    width: 3;
    min-width: 3;
    max-width: 3;
    content-align: center middle;
}

StatusBar.busy {
    color: $text-muted;
}

StatusBar.busy > #status-spinner {
    color: $accent;
}

BrowseScreen.compact #preview-pane {
    display: none;
}

BrowseScreen.compact #results-pane {
    width: 1fr;
}

#detail-preview {
    background: $boost;
}

FilterScreen, HelpScreen {
    align: center middle;
    background: $background 55%;
}

#filter-body, #help-body {
    width: 88%;
    height: 86%;
    max-width: 110;
    max-height: 42;
    padding: 1 2;
    background: $panel;
}

#filter-intro {
    height: 2;
    color: $text-muted;
}

#filter-workspace {
    height: 1fr;
    background: $surface;
}

#filter-categories {
    width: 28;
    height: 1fr;
    background: $panel;
}

#filter-categories:focus {
    background-tint: $accent 3%;
}

#filter-options-pane {
    width: 1fr;
    height: 1fr;
    background: $boost;
}

#filter-options-pane:focus-within {
    background-tint: $accent 3%;
}

#filter-options-title {
    height: 2;
    padding: 0 1;
    content-align: left middle;
    color: $text;
    text-style: bold;
}

#filter-query {
    height: 3;
    border: none;
    background: $surface;
}

#filter-query:focus {
    border-bottom: solid $accent;
}

#filter-options {
    height: 1fr;
    background: $boost;
}

#filter-options:focus {
    background-tint: $accent 3%;
}

#filter-summary {
    height: 2;
    padding-top: 1;
    color: $text-muted;
}

FilterScreen.compact #filter-body, HelpScreen.compact #help-body {
    width: 100%;
    height: 100%;
}
